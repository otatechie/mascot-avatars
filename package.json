{
  "name": "mascot-avatars",
  "version": "0.2.0",
  "description": "Procedural SVG mascot avatars in the 'IP as Logo' style: 6-10 rounded shapes, two colors, solid background, deterministic from a seed string.",
  "main": "avatar.js",
  "module": "avatar.mjs",
  "types": "avatar.d.ts",
  "exports": {
    ".": {
      "types": "./avatar.d.ts",
      "import": "./avatar.mjs",
      "require": "./avatar.js"
    }
  },
  "sideEffects": false,
  "files": [
    "avatar.js",
    "avatar.mjs",
    "avatar.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "avatar",
    "svg",
    "mascot",
    "logo",
    "identicon",
    "generator",
    "procedural"
  ],
  "author": "Ato Augustine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otatechie/mascot-avatars.git"
  },
  "homepage": "https://github.com/otatechie/mascot-avatars#readme",
  "bugs": {
    "url": "https://github.com/otatechie/mascot-avatars/issues"
  }
}
